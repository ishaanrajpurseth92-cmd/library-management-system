# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MySQL / TiDB Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=library_management
# TiDB Cloud Starter public endpoints require TLS. Set true for TiDB.
DB_SSL=false
# Optional PEM CA certificate, with newlines preserved or written as \\n sequences.
DB_SSL_CA=

# Optional one-time schema setup account (falls back to DB_USER/DB_PASSWORD).
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=

# Optional restricted app account created by the one-time database setup.
APP_DB_USER=library_app
APP_DB_PASSWORD=replace-with-a-long-unique-password

# CSRF Secret (Optional custom salt)
CSRF_SECRET=library_secret_key_change_in_production

# Set true to let the public demo open without a browser-level password prompt.
PUBLIC_DEMO=false
# Optional browser-level protection when PUBLIC_DEMO is false.
APP_DEMO_USER=library-demo
APP_DEMO_PASSWORD=replace-with-a-long-unique-password
