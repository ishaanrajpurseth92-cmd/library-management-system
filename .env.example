# Backend Environment Variables (copy to backend/.env)
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=library_management
# Set DB_SSL=true for TiDB Cloud Starter (TLS is required).
DB_SSL=false
DB_SSL_CA=

CSRF_SECRET=library_secret_key_demo_2026

# Set true to let the public demo open without a browser-level password prompt.
PUBLIC_DEMO=false
# Optional browser-level protection when PUBLIC_DEMO is false.
APP_DEMO_USER=library-demo
APP_DEMO_PASSWORD=replace-with-a-long-unique-password
